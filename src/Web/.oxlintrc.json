{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/set-state-in-effect": "warn",
    "react/purity": "warn"
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "dist-ssr/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "blob-report/**"
  ]
}
